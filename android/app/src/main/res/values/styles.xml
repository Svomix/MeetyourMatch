<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="CircleImageViewStyle" parent="Widget.MaterialComponents.ShapeableImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="UserInformationTextStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="UserInformationView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">15dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:background">@drawable/round_border_data</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="AccountButtons">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">30dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:layout_marginTop">30dp</item>
        <item name="backgroundTint">@color/messageAndButtonBackground</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">25sp</item>
    </style>

    <style name="Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@color/bars</item>
    </style>

    <style name="HeaderButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:backgroundTint">@color/bars</item>
        <item name="android:drawablePadding">10dp</item>
    </style>

    <style name="ChatTable">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@color/messageAndButtonBackground</item>
    </style>

    <style name="ChatUsernameAndMessage">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginStart">10dp</item>
    </style>

    <style name="ChatUsername">
        <item name="android:layout_width">250dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ChatMessage">
        <item name="android:layout_width">250dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/message</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ChatLastMessageTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/message</item>
    </style>

    <style name="NavigationButtons">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:layout_weight">1</item>
        <item name="backgroundTint">@color/bars</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="CustomAlertDialog">
        <item name="android:background">@drawable/gradient_background</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:dialogCornerRadius">20dp</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/NeutralButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
    </style>

    <style name="PositiveButtonStyle">
        <item name="android:textColor">@color/buttonColorDefault</item>
    </style>

    <style name="NeutralButtonStyle">
        <item name="android:textColor">@color/buttonColorDefault</item>
    </style>

    <style name="NegativeButtonStyle">
        <item name="android:textColor">@color/buttonColorDefault</item>
    </style>

    <style name="DialogCheckboxStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:textColor">@color/textColorPrimaryModern</item>
        <item name="buttonTint">@color/actionIconColor</item> 
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="DialogRadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:textColor">@color/textColorPrimaryModern</item>
        <item name="buttonTint">@color/actionIconColor</item> 
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        
        
        <item name="alertDialogTheme">@style/AppAlertDialogStyle</item>
    </style>

    
    <style name="AppAlertDialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        
        <item name="android:background">@color/backgroundColorModern</item> 
        
        <item name="android:textColorPrimary">@color/textColorPrimaryModern</item> 
        
        <item name="android:textColorSecondary">@color/textColorSecondaryModern</item> 
        
        <item name="colorAccent">@color/actionIconColor</item> 
        <item name="android:textColorAlertDialogListItem">@color/textColorPrimaryModern</item> 

        
        <item name="buttonBarPositiveButtonStyle">@style/AlertDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertDialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/AlertDialogButtonStyle</item>

        
        <item name="android:checkboxStyle">@style/AlertDialogCheckboxStyle</item>
        <item name="android:radioButtonStyle">@style/AlertDialogRadioButtonStyle</item>

    </style>

    
    <style name="AlertDialogButtonStyle" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/actionIconColor</item> 
    </style>

    
    <style name="AlertDialogCheckboxStyle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:textColor">@color/textColorPrimaryModern</item>
        <item name="buttonTint">@color/actionIconColor</item> 
    </style>

    
    <style name="AlertDialogRadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:textColor">@color/textColorPrimaryModern</item>
        <item name="buttonTint">@color/actionIconColor</item> 
    </style>

    <style name="ModernButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/buttonTextColorPrimary</item> 
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">6</item>
        <item name="android:gravity">center_vertical|start</item> 
    </style>

    <style name="ModernDangerButtonStyle" parent="ModernButtonStyle">
        <item name="android:background">@drawable/button_background_danger</item>
        <item name="android:textColor">@color/white</item>
    </style>

    
    <style name="ModernAcceptButtonStyle" parent="ModernButtonStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:drawableTint" tools:targetApi="m">@color/white</item>
    </style>

    <style name="ModernSecondaryButtonStyle" parent="ModernButtonStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:drawableTint" tools:targetApi="m">@color/white</item>
    </style>

</resources>
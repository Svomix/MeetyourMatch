<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/layout_sender_info_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/image_group_sender_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            tools:src="@drawable/avatar" />

        <TextView
            android:id="@+id/text_group_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/sansation_bold"
            android:textColor="@color/textColorSecondaryModern"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Имя Отправителя" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout_group_message_container_received"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_message_received"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@+id/layout_sender_info_container"
        tools:layout_editor_absoluteX="8dp">

        <TextView
            android:id="@+id/text_group_message_body_received"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:textColor="@color/textColorPrimaryModern"
            android:textSize="16sp"
            tools:text="Привет! Это тестовое сообщение в группе." />

    </LinearLayout>


    <TextView
        android:id="@+id/text_group_message_time_received"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="@color/textColorTertiaryModern"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="@+id/layout_group_message_container_received"
        app:layout_constraintStart_toEndOf="@+id/layout_group_message_container_received"
        tools:text="10:00" />

</androidx.constraintlayout.widget.ConstraintLayout>
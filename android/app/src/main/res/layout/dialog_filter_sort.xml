<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialog_filter_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Фильтры и Сортировка"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:textColor="@color/textColorPrimaryModern"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/dialog_scroll_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/dialog_buttons_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_filter_title"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintVertical_chainStyle="packed">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.AppCompat.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Фильтровать по:"
                android:textColor="@color/textColorSecondaryModern" />

            <CheckBox
                android:id="@+id/dialog_checkbox_filter_liked"
                style="@style/DialogCheckboxStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Понравившиеся" />

            <CheckBox
                android:id="@+id/dialog_checkbox_filter_calendar"
                style="@style/DialogCheckboxStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Добавленные в календарь" />

            <Button
                android:id="@+id/dialog_button_select_tags"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Выбрать теги для фильтра"
                android:textAllCaps="false"
                android:textColor="@color/actionIconColor"
                android:visibility="gone" />

            <TextView
                android:id="@+id/dialog_text_selected_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/textColorSecondaryModern"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Выбрано: Музыка, Спорт"
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/dividerColorModern" />

            <TextView
                style="@style/TextAppearance.AppCompat.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Сортировать по:"
                android:textColor="@color/textColorSecondaryModern" />

            <RadioGroup
                android:id="@+id/dialog_radiogroup_sort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/dialog_radio_sort_default"
                    style="@style/DialogRadioButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="По умолчанию (дата - старые)" />

                <RadioButton
                    android:id="@+id/dialog_radio_sort_likes"
                    style="@style/DialogRadioButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Количеству лайков (больше)" />

                <RadioButton
                    android:id="@+id/dialog_radio_sort_calendar"
                    style="@style/DialogRadioButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Добавлений в календарь (больше)" />

            </RadioGroup>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/dialog_buttons_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog_scroll_content">

        <Button
            android:id="@+id/dialog_button_cancel"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Отмена"
            android:textColor="@color/textColorSecondaryModern" />

        <Button
            android:id="@+id/dialog_button_apply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Применить"
            android:textColor="@color/buttonTextColorPrimary"
            android:background="@drawable/button_primary_dialog" /> <!-- Новый drawable для кнопки -->

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
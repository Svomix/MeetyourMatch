<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Фильтры и Сортировка"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:gravity="center"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="20dp"/>

        <TextView
            style="@style/TextAppearance.AppCompat.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Фильтровать по:"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="10dp"/>

        <CheckBox
            android:id="@+id/checkbox_filter_liked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Понравившиеся"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <CheckBox
            android:id="@+id/checkbox_filter_calendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавленные в календарь"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <Button
            android:id="@+id/button_select_tags"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Выбрать теги для фильтра"
            android:textColor="?attr/colorAccent"
            android:gravity="start|center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>

        <TextView
            android:id="@+id/text_selected_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="Выбрано: Музыка, Спорт"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            style="@style/TextAppearance.AppCompat.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сортировать по:"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/radiogroup_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radio_sort_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="По умолчанию (дата - старые)"
                android:checked="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <RadioButton
                android:id="@+id/radio_sort_likes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Количеству лайков (больше)"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

            <RadioButton
                android:id="@+id/radio_sort_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Добавлений в календарь (больше)"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"/>

        </RadioGroup>

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?android:attr/selectableItemBackground">

    <FrameLayout
        android:id="@+id/chat_avatar_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/chat_list_avatar"
            android:layout_width="55dp"
            android:layout_height="55dp"
            tools:src="@drawable/avatar" />

        <ImageView
            android:id="@+id/online_status"
            android:layout_gravity="bottom|end"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:visibility="invisible"
            android:elevation="2dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/baseline_circle_24" />

    </FrameLayout>



    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/chat_avatar_status"
        app:layout_constraintStart_toEndOf="@+id/chat_avatar_status"
        app:layout_constraintTop_toTopOf="@+id/chat_avatar_status">

        <ImageView
            android:id="@+id/chat_list_icon_friend"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="string/desc_friend_icon"
            android:src="@drawable/baseline_person_24"
            android:visibility="gone"
            app:tint="@color/buttonColorDefault"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/chat_list_icon_group"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="string/desc_friend_icon"
            android:src="@drawable/baseline_group_24"
            android:visibility="gone"
            app:tint="@color/white"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/chat_list_icon_blocked"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="string/desc_blocked_icon"
            android:src="@drawable/baseline_lock_24"
            android:visibility="gone"
            app:tint="#FF8D19"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/chat_list_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?android:attr/textAppearanceListItem"
        android:textColor="@color/textColorPrimaryModern"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/chat_list_time"
        app:layout_constraintStart_toEndOf="@+id/frameLayout"
        app:layout_constraintTop_toTopOf="@id/chat_avatar_status"
        tools:text="VeryLongUsernameHere" />

    <TextView
        android:id="@+id/chat_list_last_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?android:attr/textAppearanceListItemSecondary"
        android:textColor="@color/textColorSecondaryModern"
        app:layout_constraintBottom_toBottomOf="@id/chat_avatar_status"
        app:layout_constraintEnd_toEndOf="@id/chat_list_username"
        app:layout_constraintStart_toStartOf="@id/chat_list_username"
        app:layout_constraintTop_toBottomOf="@id/chat_list_username"
        tools:text="Last message preview that could also be quite long..." />

    <TextView
        android:id="@+id/chat_list_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/textColorTertiaryModern"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/chat_list_username"
        tools:text="10:30" />

</androidx.constraintlayout.widget.ConstraintLayout>